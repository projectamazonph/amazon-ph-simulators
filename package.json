{
  "name": "amazon-ph-simulators",
  "productName": "Project Amazon PH Academy SimGrid",
  "version": "1.0.0",
  "description": "Desktop wrapper for the Project Amazon PH Academy PPC simulators.",
  "author": "Project Amazon PH Academy",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win nsis",
    "dist:win:portable": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.projectamazonph.simgrid",
    "productName": "Project Amazon PH Academy SimGrid",
    "artifactName": "SimGrid-Setup-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "index.html",
      "*.html",
      "assets/**/*",
      "learn/**/*",
      "desktop/main.cjs",
      "package.json",
      "!**/*.map"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SimGrid",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
